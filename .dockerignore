# Only source + lockfiles go into the build context. Everything below is
# either generated inside the build stage (vendor, public/bundles, var),
# runtime state that must live in volumes, or local-only configuration.

# VCS / IDE / tooling
.git
.gitignore
.idea
.claude
.php-cs-fixer.cache
.phpunit.result.cache
docs

# Local environment overrides must never be baked into the image.
# The committed .env stays (APP_ENV=prod defaults); real values come from the container environment.
.env.local
.env.local.php
.env.*.local
.env.dev
.env.test
.shopware-project.local.yml
auth.json
docker/prod.env

# Generated by composer / shopware-cli project ci inside the build stage
vendor
node_modules
**/node_modules
public/bundles
public/asset-manifest.json
sbom.cdx.json

# Runtime state (volumes) and caches
var
files
public/media
public/thumbnail
public/theme
public/sitemap
install.lock

# Docker / compose / make files are not needed inside the image
docker
compose.yaml
compose.override.yaml
compose.prod.yaml
compose.dokploy.yaml
Makefile
