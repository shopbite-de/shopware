{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "labels": ["dependencies"],
  "enabledManagers": ["composer"],
  "includePaths": ["composer.json"],
  "ignoreTests": true,
  "platformAutomerge": false,
  "postUpdateOptions": ["composerWithAll"],
  "packageRules": [
    {
      "description": "Automerge minor and patch updates",
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Shopware core, administration and storefront require each other's exact version, so they are updated together and only in the lock file (v6.7.*.* keeps 6.8 out)",
      "matchPackageNames": ["shopware/core", "shopware/administration", "shopware/storefront"],
      "groupName": "shopware",
      "rangeStrategy": "update-lockfile",
      "automerge": false
    },
    {
      "description": "Plugins in custom/plugins are path repositories and updated by replacing their source, not via Composer",
      "matchPackageNames": ["swag/paypal", "kiener/mollie-payments-plugin"],
      "enabled": false
    }
  ]
}
