{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "labels": ["dependencies"],
  "enabledManagers": ["composer"],
  "includePaths": ["composer.json"],
  "ignoreTests": true,
  "platformAutomerge": false,
  "packageRules": [
    {
      "description": "Automerge minor and patch updates",
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Renovate reads Shopware's 6.x.y.z as semver, so 6.7 -> 6.8 counts as minor although it is a breaking release",
      "matchPackageNames": ["shopware/core", "shopware/administration", "shopware/storefront"],
      "matchUpdateTypes": ["minor"],
      "automerge": false
    },
    {
      "description": "Plugins in custom/plugins are path repositories and updated by replacing their source, not via Composer",
      "matchPackageNames": ["swag/paypal", "kiener/mollie-payments-plugin"],
      "enabled": false
    }
  ]
}
