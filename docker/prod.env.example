# Copy to docker/prod.env (git-ignored) and fill in real values.
# Used for compose interpolation:  docker compose -f compose.prod.yaml --env-file docker/prod.env up -d
# Values are injected into the containers as real environment variables and
# take precedence over the committed .env inside the image.

# ---- Image -----------------------------------------------------------------
IMAGE=shopbite/shopware
TAG=latest
PHP_VERSION=8.4

# ---- Public URL / ports ------------------------------------------------------
# Put a TLS-terminating reverse proxy (Traefik, Caddy, nginx) in front of HTTP_PORT.
APP_URL=https://shop.example.com
HTTP_PORT=8000
# Proxies whose X-Forwarded-* headers are trusted. `private_ranges` = all RFC1918/docker networks.
TRUSTED_PROXIES=private_ranges

# ---- Secrets -----------------------------------------------------------------
# Generate each with: openssl rand -hex 32
APP_SECRET=
INSTANCE_ID=

# ---- Database (MariaDB service in compose.prod.yaml) ------------------------
DB_NAME=shopware
DB_USER=shopware
# No characters that need URL encoding (: / @ ? # %) - the value is embedded in DATABASE_URL.
DB_PASSWORD=
DB_ROOT_PASSWORD=

# ---- Redis / Valkey ----------------------------------------------------------
REDIS_URL=redis://valkey:6379

# ---- Mail --------------------------------------------------------------------
# e.g. smtp://user:pass@smtp.example.com:587?encryption=tls  (Admin settings override this)
MAILER_DSN=null://null

# ---- Shopware Services (Copilot, AI image editor, recommendations, ...) ------
# Disabled by default (headless shop). Set to 1 to enable; registration needs a publicly reachable APP_URL.
ENABLE_SERVICES=0

# ---- First installation only (ignored once Shopware is installed) -----------
INSTALL_LOCALE=de-DE
INSTALL_CURRENCY=EUR
INSTALL_ADMIN_USERNAME=admin
INSTALL_ADMIN_PASSWORD=
INSTALL_ADMIN_EMAIL=admin@example.com
# Storefront sales channel URL, defaults to APP_URL
SALES_CHANNEL_URL=

# ---- Tuning (defaults of the Shopware base image, override if needed) --------
PHP_MEMORY_LIMIT=512m
PHP_MAX_UPLOAD_SIZE=128m
PHP_MAX_EXECUTION_TIME=300
MONOLOG_LOG_LEVEL=error
SHOPWARE_HTTP_DEFAULT_TTL=7200
WORKER_REPLICAS=1
