# Environment variables for the Dokploy Compose service (paste into the
# "Environment" tab; Dokploy writes them to .env next to compose.dokploy.yaml).

# ---- Public URL ----------------------------------------------------------------
APP_URL=https://shop.example.com
# Traefik (Dokploy) terminates TLS; trust X-Forwarded-* from private/docker networks
TRUSTED_PROXIES=private_ranges

# ---- Secrets (openssl rand -hex 32 each) ----------------------------------------
APP_SECRET=
INSTANCE_ID=

# ---- Database (MariaDB service inside this compose project) --------------------
DB_NAME=shopware
DB_USER=shopware
# No characters that need URL encoding (: / @ ? # %) - the value is embedded in DATABASE_URL.
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_BUFFER_POOL_SIZE=512M

# ---- Valkey (service inside this compose project) ------------------------------
VALKEY_MAXMEMORY=256mb

# ---- Mail ------------------------------------------------------------------------
MAILER_DSN=null://null

# ---- Shopware Services (Copilot, AI tools, Nexus): off for the headless shop ----
ENABLE_SERVICES=0

# ---- First installation only -----------------------------------------------------
INSTALL_LOCALE=de-DE
INSTALL_CURRENCY=EUR
INSTALL_ADMIN_USERNAME=admin
INSTALL_ADMIN_PASSWORD=
INSTALL_ADMIN_EMAIL=admin@example.com

# ---- Optional tuning ---------------------------------------------------------------
IMAGE=shopbite/shopware
TAG=latest
PHP_VERSION=8.4
WORKER_REPLICAS=1
PHP_MEMORY_LIMIT=512m
PHP_MAX_UPLOAD_SIZE=128m
MONOLOG_LOG_LEVEL=error
SHOPWARE_HTTP_DEFAULT_TTL=7200
